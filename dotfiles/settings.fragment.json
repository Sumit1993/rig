{
  "permissions": {
    "allow": ["Bash(agy *)"],
    "deny": [
      "WebFetch",
      "Bash(npm run dev*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm run dev*)",
      "Bash(bun dev*)",
      "Bash(bun run dev*)",
      "Bash(next dev*)"
    ],
    "defaultMode": "auto"
  },
  "worktree": { "baseRef": "head" },
  "effortLevel": "high",
  "tui": "fullscreen",
  "extraKnownMarketplaces": {
    "rig": {
      "source": { "source": "github", "repo": "Sumit1993/rig" },
      "autoUpdate": true
    },
    "mattpocock": {
      "source": { "source": "github", "repo": "mattpocock/skills" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "rig@rig": true,
    "mattpocock-skills@mattpocock": true
  },
  "attribution": { "sessionUrl": false }
}
