{
  "permissions": {
    "allow": [
      "Bash(agy *)"
    ],
    "deny": [
      "WebFetch",
      "Bash(npm run dev*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm run dev*)",
      "Bash(bun dev*)",
      "Bash(bun run dev*)",
      "Bash(next dev*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "worktree": {
    "baseRef": "head"
  },
  "effortLevel": "high",
  "tui": "fullscreen"
}
