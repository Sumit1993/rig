{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/no-broad-agy-kill.sh\"",
            "timeout": 5,
            "statusMessage": "no-broad-agy-kill"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/merge-gate.sh\"",
            "timeout": 10,
            "statusMessage": "merge-gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/summon-gate.sh\"",
            "timeout": 10,
            "statusMessage": "summon-gate"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/safe-stash.sh\"",
            "timeout": 5,
            "statusMessage": "safe-stash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/no-thread-resolve.sh\"",
            "timeout": 10,
            "statusMessage": "no-thread-resolve"
          }
        ]
      }
    ]
  }
}
